<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehículos</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/app.css">
</head>

<body class="con-menu">

<!-- Botón dark mode -->
<div class="theme-switch" onclick="toggleTheme()">
    <div class="switch-track"><div class="switch-thumb"></div></div>
    <span id="theme-label">Dark</span>
</div>

<div class="container wide">

    <nav id="menu" class="menu"></nav>

    <h2>Vehículos registrados</h2>

    <h4>Agregar vehículo</h4>

    <input type="text" id="placa" placeholder="Placa (ej: ABC123)" maxlength="10">

    <select id="tipo">
        <option value="" disabled selected>Selecciona el tipo</option>
        <option value="Carro">🚗 Carro</option>
        <option value="Moto">🏍️ Moto</option>
    </select>

    <button onclick="crearVehiculo()">Guardar vehículo</button>

    <hr>

    <button class="btn-secondary" onclick="cargarVehiculos()">↻ Actualizar lista</button>

    <table>
        <thead>
            <tr>
                <th>Placa</th>
                <th>Tipo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla"></tbody>
    </table>

</div>

<!-- Modal edición -->
<div id="modalEditar" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:999; align-items:center; justify-content:center; backdrop-filter:blur(4px);">
    <div style="background:var(--card-bg); border:1px solid var(--card-border); border-radius:18px; padding:32px 28px; width:100%; max-width:380px; box-shadow:var(--card-shadow);">
        <h2 style="margin-bottom:6px;">Editar vehículo</h2>
        <p style="margin-bottom:20px;">Placa: <strong id="modalPlaca"></strong></p>

        <select id="tipoEditar" style="width:100%; padding:11px 14px; margin:6px 0; background:var(--input-bg); border:1px solid var(--border); border-radius:10px; color:var(--text-primary); font-size:0.9rem; font-family:inherit; outline:none;">
            <option value="Carro">🚗 Carro</option>
            <option value="Moto">🏍️ Moto</option>
        </select>

        <button onclick="confirmarEdicion()" style="margin-top:16px;">Guardar cambios</button>
        <button class="btn-secondary" onclick="cerrarModal()" style="margin-top:8px;">Cancelar</button>
    </div>
</div>

<script>window.API_URL = "<%= API_URL %>";</script>
<script src="/js/comun.js"></script>
<script>
exigirSesion();
pintarMenu('/vehiculos');

/* ── CARGAR ── */
async function cargarVehiculos() {
    try {
        const data = await api('GET', '/api/vehiculos');
        const tabla = document.getElementById('tabla');
        tabla.innerHTML = data.map(v => {
            const icono = v.tipo === 'Moto' ? '🏍️' : '🚗';
            return `
            <tr>
                <td>${esc(v.placa)}</td>
                <td>${icono} ${esc(v.tipo)}</td>
                <td>
                    <button class="btn-sm" onclick="abrirModal('${esc(v.placa)}', '${esc(v.tipo)}')">Editar</button>
                    <button class="btn-sm danger" onclick="eliminarVehiculo('${esc(v.placa)}')">Eliminar</button>
                </td>
            </tr>`;
        }).join('');
    } catch (e) {
        alert(e.message);
    }
}

/* ── CREAR ── */
async function crearVehiculo() {
    const placa = document.getElementById('placa').value.trim();
    const tipo  = document.getElementById('tipo').value;

    if (!placa || !tipo) {
        alert('Completa la placa y selecciona el tipo.');
        return;
    }

    try {
        await api('POST', '/api/vehiculos', { placa, tipo });
        document.getElementById('placa').value = '';
        document.getElementById('tipo').value  = '';
        cargarVehiculos();
    } catch (e) {
        alert(e.message);
    }
}

/* ── MODAL ── */
function abrirModal(placa, tipoActual) {
    document.getElementById('modalPlaca').textContent = placa;
    document.getElementById('tipoEditar').value       = tipoActual;
    document.getElementById('modalEditar').style.display = 'flex';
}

function cerrarModal() {
    document.getElementById('modalEditar').style.display = 'none';
}

/* ── EDITAR ── */
async function confirmarEdicion() {
    const placa = document.getElementById('modalPlaca').textContent;
    const tipo  = document.getElementById('tipoEditar').value;

    try {
        await api('PUT', '/api/vehiculos/' + encodeURIComponent(placa), { tipo });
        cerrarModal();
        cargarVehiculos();
    } catch (e) {
        alert(e.message);
    }
}

/* ── ELIMINAR ── */
async function eliminarVehiculo(placa) {
    if (!confirm(`¿Eliminar el vehículo con placa ${placa}?`)) return;

    try {
        await api('DELETE', '/api/vehiculos/' + encodeURIComponent(placa));
        cargarVehiculos();
    } catch (e) {
        alert(e.message);
    }
}

/* ── Cargar al iniciar ── */
cargarVehiculos();
</script>

</body>
</html>
