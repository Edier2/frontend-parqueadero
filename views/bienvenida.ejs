<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Parqueadero — Cargando</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            background: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
            overflow: hidden;
        }

        /* ── FONDO ── */
        .bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            background: #0f172a;
        }
        .bg::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse at 30% 40%, rgba(47,128,237,.2) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 60%, rgba(139,92,246,.15) 0%, transparent 50%);
            animation: bgAnim 3s ease-in-out infinite alternate;
        }
        @keyframes bgAnim {
            from { opacity: .5; transform: scale(1); }
            to   { opacity: 1; transform: scale(1.05); }
        }

        /* ── PARTÍCULAS ── */
        .particle {
            position: fixed;
            border-radius: 50%;
            background: rgba(47,128,237,.2);
            animation: floatUp linear infinite;
            z-index: 0;
        }
        @keyframes floatUp {
            0%   { transform: translateY(100vh) scale(0); opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: 1; }
            100% { transform: translateY(-10vh) scale(1); opacity: 0; }
        }

        /* ── CONTENIDO ── */
        .wrap {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
            text-align: center;
        }

        /* Círculo de carga */
        .circle-wrap {
            position: relative;
            width: 120px;
            height: 120px;
            margin-bottom: 40px;
            animation: fadeIn .5s .3s ease both;
        }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .circle-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,.08);
        }
        .circle-progress {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 3px solid transparent;
            border-top-color: #2f80ed;
            border-right-color: #6366f1;
            animation: spin 1s linear infinite;
        }
        .circle-inner {
            position: absolute;
            inset: 12px;
            border-radius: 50%;
            background: rgba(47,128,237,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* Texto */
        .welcome-text {
            animation: slideUp .7s .4s cubic-bezier(.4,0,.2,1) both;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .greeting {
            font-size: 1rem;
            font-weight: 400;
            color: rgba(255,255,255,.5);
            letter-spacing: .12em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .titulo {
            font-size: 2.2rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.04em;
            line-height: 1.1;
            margin-bottom: 6px;
        }
        .titulo span { color: #60a5fa; }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(47,128,237,.15);
            border: 1px solid rgba(47,128,237,.3);
            border-radius: 20px;
            padding: 6px 16px;
            font-size: .82rem;
            font-weight: 600;
            color: #93c5fd;
            letter-spacing: .04em;
            margin-top: 12px;
            animation: slideUp .7s .6s cubic-bezier(.4,0,.2,1) both;
        }

        /* Barra de progreso */
        .progress-wrap {
            width: 280px;
            margin-top: 40px;
            animation: fadeIn .5s .7s ease both;
        }
        .progress-label {
            font-size: .75rem;
            color: rgba(255,255,255,.3);
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }
        .progress-bar {
            height: 3px;
            background: rgba(255,255,255,.08);
            border-radius: 2px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #2f80ed, #6366f1, #8b5cf6);
            border-radius: 2px;
            width: 0%;
            transition: width .1s linear;
        }

        /* Puntos */
        .dots {
            display: flex;
            gap: 6px;
            margin-top: 20px;
            animation: fadeIn .5s .8s ease both;
        }
        .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,.2);
            animation: dotPulse 1.2s ease-in-out infinite;
        }
        .dot:nth-child(2) { animation-delay: .2s; }
        .dot:nth-child(3) { animation-delay: .4s; }
        @keyframes dotPulse {
            0%,80%,100% { transform: scale(1); background: rgba(255,255,255,.2); }
            40%          { transform: scale(1.4); background: #2f80ed; }
        }

        /* Mensaje del sistema */
        .sys-msg {
            margin-top: 16px;
            font-size: .78rem;
            color: rgba(255,255,255,.25);
            letter-spacing: .04em;
            animation: fadeIn .5s 1s ease both;
            min-height: 18px;
            transition: opacity .2s;
        }

        /* Fade out */
        body.fade-out {
            animation: fadeOut .5s ease forwards;
        }
        @keyframes fadeOut { to { opacity: 0; } }
    </style>
</head>
<body>

<div class="bg"></div>
<div id="particles"></div>

<div class="wrap">

    <!-- Círculo animado -->
    <div class="circle-wrap">
        <div class="circle-bg"></div>
        <div class="circle-progress"></div>
        <div class="circle-inner">🚗</div>
    </div>

    <!-- Texto -->
    <div class="welcome-text">
        <div class="greeting">Bienvenido de nuevo</div>
        <div class="titulo">Sistema de <span>Parqueadero</span></div>
        <div class="role-badge">🔐 Sesión iniciada correctamente</div>
    </div>

    <!-- Progreso -->
    <div class="progress-wrap">
        <div class="progress-label">Cargando tu espacio de trabajo</div>
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>

    <div class="dots">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
    </div>

    <div class="sys-msg" id="sysMsg">Verificando sesión...</div>

</div>

<script>
    // Redirigir si no hay token
    const token = localStorage.getItem('token');
    if (!token) {
        window.location.href = '/';
    }

    // Partículas
    (function() {
        const c = document.getElementById('particles');
        for (let i = 0; i < 12; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            const size = Math.random() * 60 + 20;
            p.style.cssText = `
                width:${size}px; height:${size}px;
                left:${Math.random() * 100}vw;
                animation-duration:${Math.random() * 15 + 10}s;
                animation-delay:${Math.random() * 8}s;
                opacity:${Math.random() * .12 + .04}
            `;
            c.appendChild(p);
        }
    })();

    // Mensajes progresivos
    const mensajes = [
        'Verificando sesión...',
        'Cargando vehículos...',
        'Preparando el sistema...',
        'Casi listo...',
        '¡Todo en orden!',
    ];

    let progreso = 0;
    let msgIdx   = 0;
    const fill   = document.getElementById('progressFill');
    const msg    = document.getElementById('sysMsg');

    const interval = setInterval(() => {
        progreso += Math.random() * 10 + 5;
        if (progreso > 100) progreso = 100;
        fill.style.width = progreso + '%';

        const nuevoIdx = Math.floor((progreso / 100) * mensajes.length);
        if (nuevoIdx !== msgIdx && nuevoIdx < mensajes.length) {
            msgIdx = nuevoIdx;
            msg.style.opacity = '0';
            setTimeout(() => {
                msg.textContent  = mensajes[msgIdx];
                msg.style.opacity = '1';
            }, 200);
        }

        if (progreso >= 100) {
            clearInterval(interval);
            msg.textContent  = '¡Listo! Redirigiendo...';
            msg.style.opacity = '1';

            setTimeout(() => {
                document.body.classList.add('fade-out');
                setTimeout(() => {
                    window.location.href = '/vehiculos';
                }, 500);
            }, 600);
        }
    }, 180);
</script>

</body>
</html>
